# OpenRouter or OpenAI API Key
OPENAI_API_KEY=your_openrouter_or_openai_key_here

# OpenRouter Base URL (Default: https://openrouter.ai/api/v1)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Preferred Model on OpenRouter (e.g., mistralai/mistral-7b-instruct:free, meta-llama/llama-3.2-3b-instruct:free)
MODEL_ID=mistralai/mistral-7b-instruct:free

# Pexels API Key for visual card results
PEXELS_API_KEY=your_pexels_api_key_here
